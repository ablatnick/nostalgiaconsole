{
  "name": "nostalgiaconsole",
  "version": "0.9.0",
  "description": "An Xbox 360 NXE-style dashboard for your Steam library",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron . --no-sandbox --windowed",
    "test": "node --test test/*.test.js",
    "fixture": "node test/make-fixture.js",
    "shot": "electron . --no-sandbox --steam-root=test/fixture/Steam --user-data=test/.userdata --capture=shot.png",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "author": "ablatnick",
  "license": "MIT",
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "three": "0.170.0"
  },
  "productName": "NostalgiaConsole",
  "build": {
    "appId": "io.github.ablatnick.nostalgiaconsole",
    "productName": "NostalgiaConsole",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
